namespace arm092.migrations

import context "go:context"
import sql "go:database/sql"
import errors "go:errors"
import os "go:os"
import filepath "go:path/filepath"
import regexp "go:regexp"
import sort "go:sort"
import strconv "go:strconv"
import strings "go:strings"
import sha256 "go:crypto/sha256"
import fmt "go:fmt"

type migration struct {
	Name string
	Version string
	Up string
	Down string
	Checksum string
	DownChecksum string
}

func migrationFiles(directory string) [] migration {
	files := [] migration {}
	versions := map[int] bool {}
	ups := map[string] bool {}
	downs := map[string] string {}
	entries := [] os.DirEntry {}
	try { entries = os.ReadDir(directory) } catch err GoError { throw new MigrationError("Cannot read SQL migration directory: " + err.message) }
	for _, entry := range entries {
		if entry.IsDir() { continue }
		name := entry.Name()
		if strings.HasSuffix(name, ".down.sql") {
			base := strings.TrimSuffix(name, ".down.sql") + ".sql"
			if ! regexp.MatchString(`^[0-9]+_[a-z0-9_]+\.sql$`, base) { throw new MigrationError("Invalid SQL migration filename: " + name) }
			downs[base] = name
			continue
		}
		if ! strings.HasSuffix(name, ".sql") { continue }
		if ! regexp.MatchString(`^[0-9]+_[a-z0-9_]+\.sql$`, name) { throw new MigrationError("Invalid SQL migration filename: " + name) }
		version := strings.SplitN(name, "_", 2) [0]
		number := 0
		try { number = strconv.Atoi(version) } catch err GoError { throw new MigrationError("Invalid SQL migration version: " + version) }
		if versions[number] { throw new MigrationError("Duplicate SQL migration version: " + version) }
		versions[number] = true
		ups[name] = true
		data := [] byte {}
		try { data = os.ReadFile(filepath.Join(directory, name)) } catch err GoError { throw new MigrationError("Cannot read SQL migration " + name + ": " + err.message) }
		statement := string(data)
		if strings.TrimSpace(statement) == "" { throw new MigrationError("Empty SQL migration: " + name) }
		checksum := fmt.Sprintf("%x", sha256.Sum256([] byte(strings.ReplaceAll(statement, "\r\n", "\n"))))
		files = append(files, migration { Name: name, Version: version, Up: statement, Checksum: checksum })
	}
	if len(files) == 0 { throw new MigrationError("No SQL migrations found in " + directory) }
	for name := range downs { if ! ups[name] { throw new MigrationError("Rollback SQL has no matching migration: " + downs[name]) } }
	sort.Slice(files, func (i int, j int) bool {
			left := strconv.Atoi(files[i].Version)
			right := strconv.Atoi(files[j].Version)
			return left < right
		})
	for i := range files {
		if downName, ok := downs[files[i].Name]; ok {
			try { files[i].Down = string(os.ReadFile(filepath.Join(directory, downName))) } catch err GoError { throw new MigrationError("Cannot read rollback SQL " + downName + ": " + err.message) }
			if strings.TrimSpace(files[i].Down) == "" { throw new MigrationError("Empty rollback SQL: " + downName) }
			files[i].DownChecksum = fmt.Sprintf("%x", sha256.Sum256([] byte(strings.ReplaceAll(files[i].Down, "\r\n", "\n"))))
		}
	}
	return files
}

func rollbackMigration(tx * sql.Tx) {
	try { tx.Rollback() } catch err GoError {
		if ! errors.Is(err.cause, sql.ErrTxDone) { throw err }
	}
}

class Migrator {
	private db * sql.DB
	private directory string
	private dialect string

	constructor(db * sql.DB, directory string, dialect string = "sqlite") {
		if db == nil { throw new MigrationError("Database connection is required") }
		if directory == "" { throw new MigrationError("Migration directory is required") }
		if dialect != "sqlite" && dialect != "mysql" && dialect != "postgres" { throw new MigrationError("Unsupported migration dialect: " + dialect) }
		this.db = db
		this.directory = directory
		this.dialect = dialect
	}

	private func history(files[] migration) map[string] string {
		create := "CREATE TABLE IF NOT EXISTS schema_migrations (version TEXT PRIMARY KEY,checksum TEXT NOT NULL,down_checksum TEXT NOT NULL DEFAULT '')"
		lookup := "SELECT name FROM pragma_table_info('schema_migrations') WHERE name='down_checksum'"
		addition := "ALTER TABLE schema_migrations ADD COLUMN down_checksum TEXT NOT NULL DEFAULT ''"
		if this.dialect == "mysql" {
			create = "CREATE TABLE IF NOT EXISTS schema_migrations (version VARCHAR(255) PRIMARY KEY,checksum CHAR(64) NOT NULL,down_checksum CHAR(64) NOT NULL DEFAULT '')"
			lookup = "SELECT column_name FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='schema_migrations' AND column_name='down_checksum'"
			addition = "ALTER TABLE schema_migrations ADD COLUMN down_checksum CHAR(64) NOT NULL DEFAULT ''"
		}
		if this.dialect == "postgres" {
			lookup = "SELECT column_name FROM information_schema.columns WHERE table_schema=current_schema() AND table_name='schema_migrations' AND column_name='down_checksum'"
		}
		try { this.db.Exec(create) } catch err GoError { throw new MigrationError("Cannot initialize migration history: " + err.message) }
		var column string
		try { this.db.QueryRow(lookup).Scan(& column) } catch err GoError {
			if ! errors.Is(err.cause, sql.ErrNoRows) { throw new MigrationError("Cannot inspect migration history: " + err.message) }
			try { this.db.Exec(addition) } catch alterErr GoError { throw new MigrationError("Cannot upgrade migration history: " + alterErr.message) }
		}
		var rows * sql.Rows
		try { rows = this.db.Query("SELECT version,checksum,down_checksum FROM schema_migrations ORDER BY version") } catch err GoError { throw new MigrationError("Cannot read migration history: " + err.message) }
		defer rows.Close()
		applied := map[string] string {}
		rollbackChecksums := map[string] string {}
		for rows.Next() {
			var version string
			var checksum string
			var downChecksum string
			try { rows.Scan(& version, & checksum, & downChecksum) } catch err GoError { throw new MigrationError("Cannot read migration history: " + err.message) }
			applied[version] = checksum
			rollbackChecksums[version] = downChecksum
		}
		rows.Close()
		try { rows.Err() } catch err GoError { throw new MigrationError("Cannot read migration history: " + err.message) }
		for name, checksum := range applied {
			found := false
			for _, file := range files {
				if file.Name == name {
					found = true
					if file.Checksum != checksum { throw new MigrationError("Applied SQL migration is missing or changed: " + name) }
					if rollbackChecksums[name] != "" && file.DownChecksum != rollbackChecksums[name] { throw new MigrationError("Applied rollback SQL is missing or changed: " + name) }
				}
			}
			if ! found { throw new MigrationError("Applied SQL migration is missing or changed: " + name) }
		}
		latest := - 1
		for i, file := range files { if applied[file.Name] != "" { latest = i } }
		for i, file := range files {
			if applied[file.Name] == "" && i < latest { throw new MigrationError("SQL migrations cannot be inserted before applied history: " + file.Name) }
		}
		return applied
	}

	public func Version() string {
		files := migrationFiles(this.directory)
		applied := this.history(files)
		latest := ""
		for _, file := range files { if applied[file.Name] != "" { latest = file.Name } }
		return latest
	}

	public func Up() int { return this.UpWithAdoption(nil) }

	public func UpWithAdoption(adopt func (* sql.Tx, string) bool) int {
		files := migrationFiles(this.directory)
		applied := this.history(files)
		insert := "INSERT INTO schema_migrations(version,checksum,down_checksum) VALUES (?,?,?)"
		if this.dialect == "postgres" { insert = "INSERT INTO schema_migrations(version,checksum,down_checksum) VALUES ($1,$2,$3)" }
		count := 0
		for _, file := range files {
			if applied[file.Name] != "" { continue }
			if this.dialect == "mysql" {
				if adopt != nil {
					var inspect * sql.Tx
					try { inspect = this.db.BeginTx(context.Background(), nil) } catch err GoError { throw new MigrationError("Cannot inspect MySQL migration " + file.Name + ": " + err.message) }
					try {
						if adopt(inspect, file.Name) {
							inspect.Exec(insert, file.Name, file.Checksum, file.DownChecksum)
							inspect.Commit()
							count++
							continue
						}
						rollbackMigration(inspect)
					} catch err GoError {
						rollbackMigration(inspect)
						throw new MigrationError("Cannot inspect MySQL migration " + file.Name + ": " + err.message)
					} catch err Exception {
						rollbackMigration(inspect)
						throw err
					}
				}
				try { this.db.Exec(file.Up) } catch err GoError { throw new MigrationError("Cannot apply MySQL migration " + file.Name + "; schema may need manual reconciliation: " + err.message) }
				try { this.db.Exec(insert, file.Name, file.Checksum, file.DownChecksum) } catch err GoError { throw new MigrationError("MySQL migration " + file.Name + " ran but history was not recorded; manual reconciliation required: " + err.message) }
				count++
				continue
			}
			var tx * sql.Tx
			try { tx = this.db.BeginTx(context.Background(), nil) } catch err GoError { throw new MigrationError("Cannot start SQL migration " + file.Name + ": " + err.message) }
			try {
				skip := false
				if adopt != nil { skip = adopt(tx, file.Name) }
				if ! skip { tx.Exec(file.Up) }
				tx.Exec(insert, file.Name, file.Checksum, file.DownChecksum)
				tx.Commit()
			} catch err GoError {
				rollbackMigration(tx)
				throw new MigrationError("Cannot apply SQL migration " + file.Name + ": " + err.message)
			} catch err Exception {
				rollbackMigration(tx)
				throw err
			}
			count++
		}
		return count
	}

	public func Down(steps int) int {
		if steps <= 0 { throw new MigrationError("Rollback steps must be positive") }
		files := migrationFiles(this.directory)
		applied := this.history(files)
		selected := [] migration {}
		for i := len(files) - 1; i >= 0; i-- {
			if applied[files[i].Name] != "" { selected = append(selected, files[i]) }
		}
		if steps > len(selected) { throw new MigrationError("Rollback exceeds applied migration count") }
		for i := 0; i < steps; i++ {
			if selected[i].Down == "" { throw new MigrationError("Rollback SQL is missing for " + selected[i].Name) }
		}
		for i := 0; i < steps; i++ {
			file := selected[i]
			deleteStatement := "DELETE FROM schema_migrations WHERE version=?"
			if this.dialect == "postgres" { deleteStatement = "DELETE FROM schema_migrations WHERE version=$1" }
			if this.dialect == "mysql" {
				try { this.db.Exec(file.Down) } catch err GoError { throw new MigrationError("Cannot roll back MySQL migration " + file.Name + "; schema may need manual reconciliation: " + err.message) }
				try { this.db.Exec(deleteStatement, file.Name) } catch err GoError { throw new MigrationError("MySQL rollback " + file.Name + " ran but history was not removed; manual reconciliation required: " + err.message) }
				continue
			}
			var tx * sql.Tx
			try { tx = this.db.BeginTx(context.Background(), nil) } catch err GoError { throw new MigrationError("Cannot start rollback of " + file.Name + ": " + err.message) }
			try {
				tx.Exec(file.Down)
				tx.Exec(deleteStatement, file.Name)
				tx.Commit()
			} catch err GoError {
				rollbackMigration(tx)
				throw new MigrationError("Cannot roll back SQL migration " + file.Name + ": " + err.message)
			} catch err Exception {
				rollbackMigration(tx)
				throw err
			}
		}
		return steps
	}
}
