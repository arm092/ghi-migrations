namespace tests
import arm092.migrations.Column
import arm092.migrations.MigrationError
import arm092.migrations.Migrator
import arm092.migrations.SchemaBuilder
import arm092.migrations.SchemaChange
import sql "go:database/sql"
import _ "go:github.com/go-sql-driver/mysql"
import _ "go:github.com/jackc/pgx/v5/stdlib"
import os "go:os"
import filepath "go:path/filepath"
import strings "go:strings"

import testing "go:testing"

func TestMySQLSchemaSQLAndSafety(t *testing.T) {
	builder := new SchemaBuilder("mysql")
	create := builder.CreateTable("accounts", []Column{
		builder.Integer("id", false, true),
		builder.String("email", 120, false),
		builder.Blob("data", true),
	})
	if create.UpSQL() != "CREATE TABLE `accounts` (`id` BIGINT AUTO_INCREMENT PRIMARY KEY, `email` VARCHAR(120) NOT NULL, `data` LONGBLOB);" {
		t.Fatal("wrong MySQL CREATE TABLE SQL: " + create.UpSQL())
	}
	index := builder.CreateIndex("accounts_email_unique", "accounts", []string{
		"email",
	}, true)
	if index.DownSQL() != "DROP INDEX `accounts_email_unique` ON `accounts`;" {
		t.Fatal("wrong MySQL index rollback")
	}
	failed := false
	try {
		builder.Write(t.TempDir(), "001_accounts.sql", []SchemaChange{
			create,
			index,
		})
	} catch err MigrationError {
		failed = strings.Contains(err.message, "one change")
	}
	if !failed {
		t.Fatal("multi-DDL MySQL migration was accepted")
	}
}

func TestPostgresSchemaSQL(t *testing.T) {
	builder := new SchemaBuilder("postgres")
	create := builder.CreateTable("accounts", []Column{
		builder.Integer("id", false, true),
		builder.Text("email", false),
		builder.Real("balance", true),
		builder.Blob("data", true),
	})
	if create.UpSQL() != "CREATE TABLE \"accounts\" (\"id\" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, \"email\" TEXT NOT NULL, \"balance\" DOUBLE PRECISION, \"data\" BYTEA);" {
		t.Fatal("wrong PostgreSQL CREATE TABLE SQL: " + create.UpSQL())
	}
	index := builder.CreateIndex("accounts_email_unique", "accounts", []string{
		"email",
	}, true)
	if index.DownSQL() != "DROP INDEX \"accounts_email_unique\";" {
		t.Fatal("wrong PostgreSQL index rollback")
	}
	failed := false
	try {
		builder.CreateTable("wrong", []Column{
			new SchemaBuilder("sqlite").Text("name", false),
		})
	} catch err MigrationError {
		failed = true
	}
	if !failed {
		t.Fatal("mixed-dialect columns were accepted")
	}
}

func TestMySQLMigrationIntegration(t *testing.T) {
	dsn := os.Getenv("GHI_TEST_MYSQL_DSN")
	if dsn == "" {
		t.Skip("GHI_TEST_MYSQL_DSN is not set")
	}
	db := sql.Open("mysql", dsn)
	defer db.Close()
	db.Ping()
	db.Exec("DROP TABLE IF EXISTS accounts")
	db.Exec("DROP TABLE IF EXISTS blocked")
	db.Exec("DROP TABLE IF EXISTS schema_migrations")
	directory := t.TempDir()
	builder := new SchemaBuilder("mysql")
	builder.Write(directory, "001_accounts.sql", []SchemaChange{
		builder.CreateTable("accounts", []Column{
			builder.Integer("id", false, true),
			builder.String("email", 120, false),
		}),
	})
	builder.Write(directory, "002_index.sql", []SchemaChange{
		builder.CreateIndex("accounts_email_unique", "accounts", []string{
			"email",
		}, true),
	})
	migrator := new Migrator(db, directory, "mysql")
	if migrator.Up() != 2 || migrator.Up() != 0 || migrator.Version() != "002_index.sql" {
		t.Fatal("MySQL migration apply failed")
	}
	db.Exec("INSERT INTO accounts(email) VALUES ('ada@example.test')")
	if migrator.Down(2) != 2 || migrator.Version() != "" {
		t.Fatal("MySQL rollback failed")
	}
	var count int
	db.QueryRow("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name='accounts'").Scan(&count)
	if count != 0 {
		t.Fatal("MySQL table remained after rollback")
	}
	db.Exec("DROP TABLE schema_migrations")
	db.Exec("CREATE TABLE schema_migrations (version VARCHAR(255) PRIMARY KEY,checksum CHAR(64) NOT NULL)")
	if migrator.Up() != 2 || migrator.Down(2) != 2 {
		t.Fatal("legacy MySQL ledger upgrade failed")
	}
	put(t, directory, "003_blocked.sql", "CREATE TABLE blocked(id BIGINT)")
	put(t, directory, "003_blocked.down.sql", "DROP TABLE blocked")
	db.Exec("CREATE TABLE blocked(id BIGINT)")
	failed := false
	try {
		migrator.Up()
	} catch err MigrationError {
		failed = strings.Contains(err.message, "manual reconciliation")
	}
	if !failed {
		t.Fatal("MySQL DDL failure was not reported for manual reconciliation")
	}
	if migrator.UpWithAdoption(func(tx *sql.Tx, name string) bool {
		return name == "003_blocked.sql"
	}) != 1 {
		t.Fatal("MySQL adoption did not record inspected change")
	}
	if migrator.Down(1) != 1 {
		t.Fatal("adopted MySQL migration did not roll back")
	}
}

func TestPostgresMigrationIntegration(t *testing.T) {
	dsn := os.Getenv("GHI_TEST_POSTGRES_DSN")
	if dsn == "" {
		t.Skip("GHI_TEST_POSTGRES_DSN is not set")
	}
	db := sql.Open("pgx", dsn)
	defer db.Close()
	db.Ping()
	db.Exec("DROP TABLE IF EXISTS accounts")
	db.Exec("DROP TABLE IF EXISTS partial")
	db.Exec("DROP TABLE IF EXISTS schema_migrations")
	directory := t.TempDir()
	builder := new SchemaBuilder("postgres")
	builder.Write(directory, "001_accounts.sql", []SchemaChange{
		builder.CreateTable("accounts", []Column{
			builder.Integer("id", false, true),
			builder.Text("email", false),
		}),
		builder.CreateIndex("accounts_email_unique", "accounts", []string{
			"email",
		}, true),
	})
	migrator := new Migrator(db, directory, "postgres")
	if migrator.Up() != 1 || migrator.Up() != 0 || migrator.Version() != "001_accounts.sql" {
		t.Fatal("PostgreSQL migration apply failed")
	}
	db.Exec("INSERT INTO accounts(email) VALUES ('ada@example.test')")
	put(t, directory, "002_bad.sql", "CREATE TABLE partial(id BIGINT); INSERT INTO missing_table VALUES (1);")
	failed := false
	try {
		migrator.Up()
	} catch err MigrationError {
		failed = true
	}
	if !failed {
		t.Fatal("invalid PostgreSQL migration succeeded")
	}
	var partial int
	db.QueryRow("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=current_schema() AND table_name='partial'").Scan(&partial)
	if partial != 0 || migrator.Version() != "001_accounts.sql" {
		t.Fatal("failed PostgreSQL DDL was not atomic")
	}
	os.Remove(filepath.Join(directory, "002_bad.sql"))
	if migrator.Down(1) != 1 || migrator.Version() != "" {
		t.Fatal("PostgreSQL rollback failed")
	}
	var count int
	db.QueryRow("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=current_schema() AND table_name='accounts'").Scan(&count)
	if count != 0 {
		t.Fatal("PostgreSQL table remained after rollback")
	}
	db.Exec("DROP TABLE schema_migrations")
	db.Exec("CREATE TABLE schema_migrations (version TEXT PRIMARY KEY,checksum TEXT NOT NULL)")
	if migrator.Up() != 1 || migrator.Down(1) != 1 {
		t.Fatal("legacy PostgreSQL ledger upgrade failed")
	}
}
